{
  "name": "ox",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:container": "vite --host",
    "build": "npm run gather-licenses && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "gather-licenses": "license-checker-rseidelsohn --json --relativeModulePath --relativeLicensePath --customPath licensesFormat.json --out src/assets/licenses.json"
  },
  "dependencies": {
    "appwrite": "^23.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.17.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "daisyui": "^5.5.19",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "license-checker-rseidelsohn": "^4.3.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "vue-tsc": "^3.2.6"
  }
}
